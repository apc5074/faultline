{
  "name": "@faultline/webmcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm --filter @faultline/agent-capabilities build && pnpm run build && node scripts/verify-to-webmcp-tool.mjs && node scripts/verify-phase6-read-surface.mjs"
  },
  "dependencies": {
    "@faultline/agent-capabilities": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
