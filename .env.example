# Faultline environment contract
# Copy this file to .env for local development. Do not commit real values.

# Browser-safe Supabase project URL. Reserved; not required until P0-005.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key. Required for the P0-005 health probe.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy browser-safe Supabase anon key. Optional compatibility fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key for privileged server operations. Reserved; not required yet.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Vercel AI Gateway key. Reserved; not required until P0-006.
AI_GATEWAY_API_KEY=

# Server-only model identifier for the AI Gateway probe. Use openai/gpt-5-nano for low-cost testing.
FAULTLINE_AGENT_MODEL=

# Public Chrome WebMCP origin-trial token. Optional; required only for the WebMCP browser spike.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=
