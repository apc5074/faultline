# Faultline environment contract
# Copy this file to .env for local development. Do not commit real values.
# Values with NEXT_PUBLIC_ are intentionally browser-visible; all others are server-only.

# Browser-safe Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy browser-safe Supabase anon key. Optional compatibility fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only aliases used by server-side Supabase clients.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Server-only direct database connection settings. Never expose these to the browser.
DB_PASS=
DIRECT_CONNECT=

# Server-only Vercel AI Gateway key.
AI_GATEWAY_API_KEY=

# Server-only model identifier for the AI Gateway.
FAULTLINE_AGENT_MODEL=openai/gpt-5-nano

# Public Chrome WebMCP origin-trial token. Optional.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=

# Public feature flags. Set production values in the deployment environment.
NEXT_PUBLIC_FAULTLINE_AI_ENABLED=true
NEXT_PUBLIC_FAULTLINE_LOAD_ANSWER=false
NEXT_PUBLIC_FAULTLINE_DEV_EXPERIMENTS=false

# Local runtime mode.
NODE_ENV=development
